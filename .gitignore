# Build trees (CMake presets put each configuration under build/<preset>).
build/
out/
cmake-build-*/

# Generated by the build
compile_commands.json
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.app/

# Model weights are downloaded at runtime, never committed.
models/
*.gguf
*.onnx
ggml-*.bin

# Local recordings and session output
recordings/
Transcriptor/

# Never commit a settings file: it carries absolute paths, llm_api_key, and
# whatever prompts and context the user wrote into their own templates. The
# real one lives in the OS config dir, but a copy dropped here must not slip in.
config.json

# Loose audio/video dropped in the tree while testing.
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.webm
*.mp4

# Secrets, if any tooling ever writes one here. *.env catches secrets.env and
# friends, which .env.* alone would miss.
.env
.env.*
*.env

# Keys and certificates, under any of the usual names.
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ecdsa*
id_ed25519*
.netrc

# Pipeline output, in case an output dir is ever pointed at the source tree:
# these files hold the actual contents of someone's meeting.
transcript.txt
transcript.json
summary.txt
*.srt
*.vtt

# The asset scripts are Python
__pycache__/

# Editors / OS
.vscode/
.idea/
.cache/
.DS_Store
